# ─────────────────────────────────────────────────────────
# FaultSeeker Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# API key for OpenRouter (https://openrouter.ai)
# Required for the AI analysis pipeline.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the default model (default: openai/gpt-4o-mini)
# FAULTSEEKER_MODEL=openai/gpt-4o-mini
